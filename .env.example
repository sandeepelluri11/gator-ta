# Copy to .env (repo root). docker compose and the API both read it.
OPENAI_API_KEY=sk-...

# Local development outside Docker (defaults shown).
GATOR_DATABASE_URL=postgresql+asyncpg://gator:gator@localhost:5432/gator
GATOR_REDIS_URL=redis://localhost:6379/0
GATOR_CHAT_MODEL=gpt-4o-mini
GATOR_JUDGE_MODEL=gpt-4o
GATOR_EMBEDDING_MODEL=text-embedding-3-small
GATOR_COURSE_ID=CIS6930
